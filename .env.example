# ---------------------------------------------------------------------------
# EcoAI Portal - environment configuration
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed. Every secret the
# application needs is read from the environment - there are no credentials
# in the source tree.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------

# One of: development | testing | production
ECOAI_ENV=development

# Signs session cookies. REQUIRED in production - the app refuses to boot
# without it. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Public origin of the deployment, used to build absolute links in emails and
# OAuth redirect URIs. No trailing slash.
APP_BASE_URL=http://localhost:8000

# Bind port for the development server / gunicorn.
PORT=8000


# --- Database ---------------------------------------------------------------

# SQLAlchemy connection URL.
#   SQLite (local dev):  sqlite:///instance/ecoai.db
#   PostgreSQL:          postgresql+psycopg://user:pass@host:5432/ecoai
#
# Heroku injects DATABASE_URL as `postgres://...`; the app rewrites that to the
# psycopg3 dialect automatically, so you do not need to edit it there.
DATABASE_URL=sqlite:///instance/ecoai.db

# Log every SQL statement. Noisy - development only.
SQLALCHEMY_ECHO=false


# --- Sessions and security --------------------------------------------------

# Send session cookies only over HTTPS. Defaults to true in production and
# false otherwise; set explicitly to override.
# SESSION_COOKIE_SECURE=true

# How long a "remember me" login stays valid, in days.
REMEMBER_COOKIE_DAYS=14

# Storage backend for rate limit counters. `memory://` works for a single
# process; use Redis when running more than one worker, otherwise each worker
# keeps its own independent counters.
#   RATELIMIT_STORAGE_URI=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# Rate limits, in Flask-Limiter syntax.
RATELIMIT_LOGIN=10 per minute
RATELIMIT_SIGNUP=5 per hour
RATELIMIT_API=120 per minute
RATELIMIT_EMAIL=3 per hour


# --- Google OAuth (optional) ------------------------------------------------
#
# Leave blank to disable. When unset, the "Continue with Google" button is
# hidden and the OAuth routes return 404 - the app works fine without it.
#
# Create credentials at https://console.cloud.google.com/apis/credentials
# and register this callback as an Authorized redirect URI:
#     {APP_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# --- Outbound email (optional) ----------------------------------------------
#
# Leave MAIL_ENABLED=false to disable sending. Impact reports are then
# rendered and logged instead of delivered, which is what you want in dev.
#
# For Gmail you need 2FA plus an App Password:
#     https://myaccount.google.com/apppasswords
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=noreply@example.com
MAIL_FROM_NAME=EcoAI Portal


# --- Carbon model -----------------------------------------------------------
#
# These drive the emissions estimate. Defaults are documented with their
# sources in ecoai/services/carbon.py. Override them if you have measurements
# for your own hardware or grid.

# Datacenter Power Usage Effectiveness. 1.0 = no overhead beyond the chip.
# Global average for large operators is roughly 1.1-1.2.
CARBON_PUE=1.12

# Accelerator energy cost per floating point operation, in joules.
# Derived from an H100 SXM at ~700W delivering ~400 TFLOP/s sustained bf16.
CARBON_JOULES_PER_FLOP=1.75e-12

# Fallback grid carbon intensity in grams CO2-equivalent per kWh, used when a
# receipt carries no region or the region is unknown. 2024 world average is
# about 480; the US average is about 369.
CARBON_DEFAULT_GRID_INTENSITY=480

# Fallback active parameter count for models missing from the registry in
# ecoai/services/carbon.py. 8e9 is a small-to-mid open weight model.
CARBON_DEFAULT_ACTIVE_PARAMS=8e9


# --- Logging ----------------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# `console` for human readable local output, `json` for structured logs.
LOG_FORMAT=console
